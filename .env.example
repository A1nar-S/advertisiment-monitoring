# The only config file. `make env` copies this to .env with a random DB
# password; then fill in the Discord values. Docker compose reads it too (DB_*
# create the Postgres user), and `go run ./cmd/...` on the host loads it.
# Searches are made by users, in Discord (/watch) or the dashboard.

# Postgres (or set DATABASE_URL directly).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ads_monitor
DB_USER=admonitor
DB_PASSWORD=change_me

# Kafka (host side; compose services override this with kafka:29092)
KAFKA_BROKERS=localhost:9092
# Prefixes topic and consumer-group names so environments can share a cluster. Leave empty normally.
NAMESPACE=

# Discord bot token (Developer Portal -> your app -> Bot -> Reset Token). The
# bot service uses it for /watch etc., the notifier to post alerts.
DISCORD_BOT_TOKEN=
# Optional, for development: register the bot's commands on this one server
# only, where they update instantly. Leave empty so the bot works on every
# server it is added to. Right-click the server -> Copy Server ID.
DISCORD_GUILD_ID=

# Extra admins (may use /setup, and see and edit everyone's searches in the
# dashboard): chat accounts as platform:id, comma separated (Discord:
# right-click yourself -> Copy User ID). The Discord app's owner is always an
# admin in the bot.
ADMIN_USERS=
# Searches per user (admins are exempt).
MAX_SEARCHES_PER_USER=10
# Where people open the dashboard; login links point here. Keep the default
# for this machine only, or set your tunnel's https URL.
PUBLIC_URL=http://127.0.0.1:8080

# Pause after each message, to stay under Discord's rate limit.
NOTIFY_DELAY_MS=1000
# Flood guard: at most NOTIFY_BURST ad messages per search per window; the rest
# arrive as one digest message per search when the window is over.
NOTIFY_BURST=5
NOTIFY_BURST_WINDOW_MINUTES=10

# scraper: be gentle with ss.com. One request per feed per cycle, REQUEST_GAP_SECONDS
# apart; more pages only while the last row of a page is still unseen, up to MAX_PAGES.
CRAWL_INTERVAL_MINUTES=5
REQUEST_TIMEOUT=30
REQUEST_GAP_SECONDS=2
MAX_PAGES=5
# More than this many district feeds of one city+deal -> scrape the city-wide feed instead.
FEED_COLLAPSE_AT=3
# Discord channel ID for start/stop/error messages; leave empty to disable.
# /setup status-channel in Discord overrides it.
ADMIN_CHANNEL_ID=

# ingest: a feed seen for the first time is stored silently for this long, so first start
# (or adding a new search) never floods you with the ads that already existed.
SEED_WINDOW_SECONDS=120

# admin purge: delete listings not seen on any feed for this long. Listings are
# also the memory of "already announced", so keep this long (60 days).
RETENTION_HOURS=1440
