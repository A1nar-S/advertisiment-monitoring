# Postgres (or set DATABASE_URL directly). Must match infra/.env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ads_monitor
DB_USER=your_user
DB_PASSWORD=your_password

# Kafka (host side; compose services override this with kafka:29092)
KAFKA_BROKERS=localhost:9092
# Prefixes topic and consumer-group names so environments can share a cluster. Leave empty normally.
NAMESPACE=

# notifier
DISCORD_BOT_TOKEN=your_discord_bot_token_here
NOTIFY_DELAY_MS=1000

# scraper: be gentle with ss.com. One request per feed per cycle, REQUEST_GAP_SECONDS
# apart; a second page only if the first was all new, up to MAX_PAGES.
CRAWL_INTERVAL_MINUTES=5
REQUEST_TIMEOUT=30
REQUEST_GAP_SECONDS=2
MAX_PAGES=3
# More than this many district feeds of one city+deal -> scrape the city-wide feed instead.
FEED_COLLAPSE_AT=3
# Start/stop/error messages go here; leave empty to disable.
ADMIN_CHANNEL_ID=

# ingest: a feed seen for the first time is stored silently for this long, so first start
# (or adding a new search) never floods you with the ads that already existed.
SEED_WINDOW_SECONDS=120

# matcher / admin: who watches what (see config/users.example.yaml)
USERS_FILE=config/users.yaml
# admin purge: delete listings not seen on any feed for this long
RETENTION_HOURS=168
